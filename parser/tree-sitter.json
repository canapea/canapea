{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sol3",
      "camelcase": "Sol3",
      "title": "sol3",
      "scope": "source.sol3",
      "file-types": [
        "sol3"
      ],
      "injection-regex": "^sol3$",
      "class-name": "TreeSitterSol3"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "UPL-1.0",
    "description": "The sol3 Programming Language",
    "authors": [
      {
        "name": "Martin Feineis",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sol3",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}