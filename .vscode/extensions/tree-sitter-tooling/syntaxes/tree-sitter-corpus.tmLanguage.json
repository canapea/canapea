{
  "$schema": "../../tmLanguage.schema.json",
  "name": "Tree-sitter Corpus",
  "scopeName": "source.tree-sitter-corpus",
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#expected-tree"
    },
    {
      "include": "#source-code"
    }
  ],
  "repository": {
    "header": {
      "name": "meta.test-case.header.tree-sitter-corpus",
      "begin": "^(={3,})[\\t ]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.begin.tree-sitter-corpus"
        }
      },
      "end": "^(={3,})[\\t ]*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.heading.end.tree-sitter-corpus"
        }
      },
      "patterns": [
        {
          "match": "^([A-Za-z_][A-Za-z0-9_.-]*)(:)([\\t ]*)(.*)$",
          "captures": {
            "1": {
              "name": "entity.name.function.test-case.tree-sitter-corpus"
            },
            "2": {
              "name": "punctuation.separator.key-value.tree-sitter-corpus"
            },
            "4": {
              "name": "string.unquoted.description.tree-sitter-corpus"
            }
          }
        },
        {
          "match": "^[\\t ]*(:)([A-Za-z][A-Za-z0-9-]*)(?:(\\()([^)]*)(\\)))?[\\t ]*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.tree-sitter-corpus"
            },
            "2": {
              "name": "storage.modifier.attribute.tree-sitter-corpus"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.tree-sitter-corpus"
            },
            "4": {
              "name": "constant.other.attribute-argument.tree-sitter-corpus"
            },
            "5": {
              "name": "punctuation.section.arguments.end.tree-sitter-corpus"
            }
          }
        },
        {
          "match": "^.*$",
          "name": "entity.name.section.test-case.tree-sitter-corpus"
        }
      ]
    },
    "source-code": {
      "name": "meta.test-input.tree-sitter-corpus",
      "contentName": "meta.embedded.block.my-lang",
      "begin": "^(?=.*\\S)",
      "end": "(?=^-{3,}[\\t ]*$)",
      "patterns": [
        {
          "include": "source.sol3"
        }
      ]
    },
    "expected-tree": {
      "name": "meta.expected-tree.tree-sitter-corpus",
      "contentName": "meta.embedded.block.tree-sitter-sexp",
      "begin": "^(-{3,})[\\t ]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.separator.tree-sitter-corpus"
        }
      },
      "end": "(?=^={3,}[\\t ]*$)",
      "patterns": [
        {
          "include": "#sexp"
        }
      ]
    },
    "sexp": {
      "patterns": [
        {
          "match": "(\\()((?:ERROR|MISSING|UNEXPECTED))\\b",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.tree-sitter-sexp"
            },
            "2": {
              "name": "invalid.illegal.node.tree-sitter-sexp"
            }
          }
        },
        {
          "match": "(\\()([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.tree-sitter-sexp"
            },
            "2": {
              "name": "entity.name.type.node.tree-sitter-sexp"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)(:)",
          "captures": {
            "1": {
              "name": "variable.other.member.field.tree-sitter-sexp"
            },
            "2": {
              "name": "punctuation.separator.key-value.tree-sitter-sexp"
            }
          }
        },
        {
          "match": "\\\"(?:\\\\.|[^\\\"\\\\])*\\\"",
          "name": "string.quoted.double.tree-sitter-sexp"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b",
          "name": "support.type.node.tree-sitter-sexp"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.tree-sitter-sexp"
        }
      ]
    }
  }
}